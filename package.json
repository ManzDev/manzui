{
  "name": "manzui",
  "version": "0.0.1",
  "description": "",
  "main": "./dist/lib/manzui.js",
  "module": "./dist/lib/manzui.js",
  "files": [
    "dist/lib"
  ],
  "exports": {
    ".": "./dist/lib/manzui.js",
    "./*.js": "./dist/lib/*.js",
    "./*.css": "./dist/lib/*.css"
  },
  "sideEffects": [
    "**/*.js",
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "node .bin/build-lib.js",
    "build:all": "vite build && node .bin/build-lib.js",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "bump": "pnpm version patch -m \"chore: bump to %s\"",
    "bump:minor": "pnpm version minor -m \"chore: bump to %s\"",
    "bump:major": "pnpm version major -m \"chore: bump to %s\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "markdown-it": "^15.0.1",
    "prismjs": "^1.30.0",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
